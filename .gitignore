# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# db backups (contain user data)
/backups

# generated secret helper (Firebase service account)
/firebase-b64-correct.txt
*-firebase-adminsdk-*.json
*.keystore

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
*.env*
*.env

# db backups
/db-backups/

# scratch/temp scripts
/scratch/

# temporary swap file used by portal:sync scripts
.capacitor.player.config.bak.ts

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.agent

# android / capacitor build artifacts
**/.gradle/
**/build/
**/local.properties
**/.idea/
**/*.hprof
**/google-services.json
**/keystore.properties
**/app/src/main/assets/public/
**/app/src/main/assets/capacitor.config.json
**/app/src/main/assets/capacitor.plugins.json
**/app/src/main/res/xml/config.xml
ios/App/App/public/
ios/App/App/capacitor.config.json
ios/App/App/config.xml
ios/App/Pods/
ios/App/build/
ios/DerivedData/
